def calculator():
    print("""====CALCULATOR====
           1.ADDITION
           2.SUBRACTION
           3.MULTIPLICATION
           4.DIVISION""")
    
    operation=int(input("enter the no.of operation :"))
    a=int(input("enter a 1st value :"))
    b=int(input("enter a 2nd value :"))

    if operation==1:
        print("addition of given number :",a+b)
    if operation==2:
        print("subtraction of given number :",a-b)
    if operation==3:
        print("multiplication of given number :",a*b)
    if operation==4:
        print("division of given number :",a/b)
 


